<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.prosthetics.ui.controller.ComparisonController"
      styleClass="tab-content">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label fx:id="originalTitleLabel" styleClass="section-title" wrapText="true"/>
        <TextArea fx:id="originalArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
    </VBox>

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <Label fx:id="clonedTitleLabel" styleClass="section-title" wrapText="true"/>
        <TextArea fx:id="clonedArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
    </VBox>

</HBox>
