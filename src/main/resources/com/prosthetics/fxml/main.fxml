<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.prosthetics.ui.controller.MainController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="header-bar" spacing="10">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>
            <Label text="Prosthetic Limb Design System" styleClass="app-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="View Comparison" onAction="#handleShowComparison" styleClass="secondary-button"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="builderTab" text="Build New Prosthesis">
                <fx:include fx:id="builderWizard" source="builder-wizard.fxml"/>
            </Tab>
            <Tab fx:id="galleryTab" text="Template Gallery">
                <fx:include fx:id="templateGallery" source="template-gallery.fxml"/>
            </Tab>
            <Tab fx:id="comparisonTab" text="Comparison">
                <fx:include fx:id="comparison" source="comparison-view.fxml"/>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
